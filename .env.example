# Copy to .env in repo root (or packages/database/.env) for local development.
# Postgres from docker-compose.yml is exposed on host port 5466.
DATABASE_URL="postgresql://admin:admin@localhost:5466/market_cosmo"
NODE_ENV=development
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
WEB_URL="http://localhost:3010"

# Mailpit defaults. SMTP_USER and SMTP_PASSWORD may be omitted for local SMTP.
MAIL_FROM="Market Cosmo <no-reply@example.com>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
